# --- OBLIGATORIOS PARA PRUEBAS BASE ---

# 1. Google Gemini API (Para el Motor Lingüístico)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# 2. Telegram Bot (Para el bucle de aprobación)
TELEGRAM_TOKEN=tu_token_de_telegram_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# 3. APIs de Noticias Complementarias (Gratuitas)
# GNews: https://gnews.io (100 req/día gratis)
GNEWS_API_KEY=tu_api_key_de_gnews_aqui
# Currents API: https://currentsapi.services (200+ req/día gratis)
CURRENTS_API_KEY=tu_api_key_de_currents_aqui

# 4. Configuración de Idioma y País
# Idioma: es, en, pt, fr, etc.
# País: PE (Perú), MX (México), AR (Argentina), US, etc.
NEWS_LANG=es
NEWS_COUNTRY=PE

# 5. APIs de Multimedia (Imágenes y Videos)
PEXELS_API_KEY=tu_api_key_de_pexels_aqui
YOUTUBE_API_KEY=tu_api_key_de_youtube_aqui
GOOGLE_CX=tu_cx_de_google_custom_search_aqui
# Brave Search API (Fallback - $5/mes gratis = ~1,000 búsquedas)
# Registrarse en: https://brave.com/search/api/
BRAVE_API_KEY=tu_api_key_de_brave_aqui

# --- OPCIONALES (Para cuando integremos la Fase 4 real) ---

# 5. WordPress (Publicación de artículos)
WP_URL="https://tusitio.com/xmlrpc.php"
WP_USERNAME="tu_usuario"
WP_APP_PASSWORD="tu_contraseña_de_aplicacion_wp"

# 6. X / Twitter (Publicación de Hilos)
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_SECRET=""

# 7. Facebook (Publicación de posts)
FB_PAGE_ID=""
FB_PAGE_ACCESS_TOKEN=""
